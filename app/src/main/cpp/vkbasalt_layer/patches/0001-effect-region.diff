+    // ---- melonDS: apply the effects to a part of the screen only --------------------------------------------------
+    // The frontend reports, per swapchain extent, the rectangle (in swapchain pixels) that should receive the effects.
+    struct EffectRegion
+    {
+        uint32_t extentWidth, extentHeight;
+        int32_t  x, y;
+        uint32_t width, height;
+    };
+    std::vector<EffectRegion> effectRegions; // guarded by globalLock
+
+    static bool effectRegionEnabled()
+    {
+        static const bool enabled = pConfig->getOption<bool>("effectRegion", false);
+        return enabled;
+    }
+
+    static VkRect2D lookupEffectRegion(VkExtent2D extent)
+    {
+        for (const EffectRegion& r : effectRegions)
+        {
+            if (r.extentWidth != extent.width || r.extentHeight != extent.height)
+                continue;
+
+            int64_t x0 = std::max<int64_t>(0, r.x);
+            int64_t y0 = std::max<int64_t>(0, r.y);
+            int64_t x1 = std::min<int64_t>(extent.width, static_cast<int64_t>(r.x) + r.width);
+            int64_t y1 = std::min<int64_t>(extent.height, static_cast<int64_t>(r.y) + r.height);
+            if (x1 <= x0 || y1 <= y0)
+                break;
+
+            return VkRect2D{{static_cast<int32_t>(x0), static_cast<int32_t>(y0)}, {static_cast<uint32_t>(x1 - x0), static_cast<uint32_t>(y1 - y0)}};
+        }
+        return VkRect2D{{0, 0}, {0, 0}}; // whole image
+    }
+
+    void setEffectRegion(uint32_t extentWidth, uint32_t extentHeight, int32_t x, int32_t y, uint32_t width, uint32_t height)
+    {
+        std::lock_guard<std::mutex> l(globalLock);
+        for (auto it = effectRegions.begin(); it != effectRegions.end(); ++it)
+        {
+            if (it->extentWidth == extentWidth && it->extentHeight == extentHeight)
+            {
+                if (width == 0 || height == 0)
+                    effectRegions.erase(it);
+                else
+                    *it = EffectRegion{extentWidth, extentHeight, x, y, width, height};
+                return;
+            }
+        }
+        if (width > 0 && height > 0)
+            effectRegions.push_back(EffectRegion{extentWidth, extentHeight, x, y, width, height});
+    }
